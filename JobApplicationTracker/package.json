{
  "name": "job-application-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "start": "tsx --env-file=.env src/http/server.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@event-driven-io/emmett": "^0.42.4",
    "@event-driven-io/emmett-fastify": "^0.42.4",
    "@event-driven-io/emmett-postgresql": "^0.42.4",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
